# =========================================================================
# CONFIGURACIÓN DEL CASINO TWITCH - RUDZY FEST
# =========================================================================

# Canal de Twitch donde se escuchará !ruleta y donde transmites
TWITCH_CHANNEL=tu_canal

# Nombre de usuario de la cuenta que enviará los puntos (dueño del canal o bot)
TWITCH_BOT_USERNAME=tu_canal

# Token OAuth generado para la cuenta (obtenible en https://twitchtokengenerator.com o https://twitchapps.com/tmi/)
# Permisos requeridos: chat:read, chat:edit
TWITCH_OAUTH_TOKEN=oauth:tu_token_aqui

# Formato del comando para pagar puntos al ganador
# Variables disponibles: {user} y {prize}
POINTS_COMMAND=!points add {user} {prize}

# Cooldown en segundos entre tiradas (300 segundos = 5 minutos)
COOLDOWN_SECONDS=300

# Puerto del servidor unificado
PORT=3000
