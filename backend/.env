# =========================================================================
# CONFIGURACIÓN DEL BOT CASINO TWITCH (NestJS)
# =========================================================================

# Canal de Twitch donde se escucharán los comandos y las respuestas de BotRix
TWITCH_CHANNEL=Rudzy_tv

# Cuenta con la que se enviará el comando !p (debe ser la cuenta del Streamer o un moderador/bot autorizado)
TWITCH_BOT_USERNAME=Rudzy_tv

# Token OAuth de la cuenta TWITCH_BOT_USERNAME
# Permisos necesarios: chat:read y chat:edit
# Puedes generarlo fácilmente en: https://twitchtokengenerator.com (o https://twitchapps.com/tmi/)
# Si está vacío, el bot se conecta en modo Sólo Lectura anónimo a Rudzy_tv para que la ruleta visual funcione
TWITCH_OAUTH_TOKEN=

# Cooldown en segundos entre tiradas (300 para 5 minutos exactos de BotRix)
COOLDOWN_SECONDS=300

# Puerto del servidor WebSockets y NestJS
PORT=3000
